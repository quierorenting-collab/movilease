# Copiar a .env.local y rellenar con los valores reales.
# NUNCA commitear .env.local (ya está en .gitignore).

# --- Públicas: se inyectan en el bundle de cliente, seguras de exponer ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=https://movilease.es
NEXT_PUBLIC_WHATSAPP_NUMBER=34613267375

# --- Solo servidor: NUNCA prefijo NEXT_PUBLIC_, nunca al cliente ---
# Service role de Supabase (se salta RLS). Solo para tareas admin server-side.
SUPABASE_SERVICE_ROLE_KEY=

# Notificaciones de leads (ver src/lib/notifications/*.ts)
WEB3FORMS_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Secreto compartido para /api/revalidate (invalidación de ISR desde el admin)
REVALIDATE_SECRET=
